<?xml version="1.0" encoding="utf-8"?>
<!--
  EvilCorp Android is an INTENTIONALLY VULNERABLE training app.
  Every insecure setting below belongs to a named lab and is documented in the README.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EvilCorp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lab: deeplink. Exported, unvalidated custom scheme. -->
        <activity
            android:name=".labs.DeepLinkActivity"
            android:exported="true"
            android:theme="@style/Theme.EvilCorp">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="evilcorp" />
            </intent-filter>
        </activity>

        <!-- Lab: intentredirect. Exported proxy that forwards to arbitrary internal components. -->
        <activity
            android:name=".labs.IntentRedirectActivity"
            android:exported="true"
            android:theme="@style/Theme.EvilCorp" />

        <!-- Lab: intentredirect target. Non-exported internal admin console. -->
        <activity
            android:name=".labs.InternalAdminActivity"
            android:exported="false"
            android:theme="@style/Theme.EvilCorp" />

        <!-- Lab: provider. Exported with no permission. -->
        <provider
            android:name=".labs.NotesProvider"
            android:authorities="com.evilcorp.android.notes"
            android:exported="true" />

        <!-- Lab: broadcast. Exported, no permission, no sender check. -->
        <receiver
            android:name=".labs.PromoteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.evilcorp.android.ACTION_PROMOTE" />
            </intent-filter>
        </receiver>

        <!-- Lab: pendingintent. Exported receiver that intercepts/hijacks mutable PendingIntents. -->
        <receiver
            android:name=".labs.PendingIntentHijackReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.evilcorp.android.ACTION_DISPATCH_PI" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
